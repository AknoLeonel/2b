# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables). Nunca versione o .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable "sb_publishable_..." ou a antiga "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (secret "sb_secret_..." ou a antiga "service_role").
# SOMENTE servidor: usada na tela de Usuários e no script de criação de usuários.
SUPABASE_SECRET_KEY=

# Domínio técnico usado para transformar o usuário (ex.: "zico") em e-mail
# de login no Supabase Auth (zico@postos2b.internal). Não precisa existir.
# Se mudar depois, os usuários já criados precisam ser recriados.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=postos2b.internal

# URL pública do site (canonical, sitemap, Open Graph). Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Contatos opcionais exibidos no site
NEXT_PUBLIC_WHATSAPP_CONTATO=
NEXT_PUBLIC_EMAIL_CONTATO=
NEXT_PUBLIC_INSTAGRAM_URL=
